# font
font pango:JetBrainsMono Nerd Font 15.000000

# Super key
set $mod         Mod4
set $terminal    kitty
floating_modifier $mod

# borders
default_border          pixel 2
default_floating_border pixel 2
hide_edge_borders       --i3 none
smart_borders           on
title_align center

# gaps
gaps inner 0
gaps outer 0
smart_gaps true

# focus
focus_follows_mouse         yes
focus_on_window_activation  smart
focus_wrapping              yes
mouse_warping               output


# Workspaces
bindsym $mod+0 workspace number 10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+Tab     workspace back_and_forth
bindsym $mod+e       layout toggle split
bindsym $mod+s       layout stacking
bindsym $mod+w       layout tabbed

workspace_auto_back_and_forth   yes
workspace_layout                default

# screenshots
# select region, save, then edit
bindsym Print               exec \
                        raw_path=~/screenshots/raw_$(date +%Y-%m-%d_%H-%M-%S).png && \
                        grim -g "$(slurp)" "$raw_path" && \
                        swappy -f "$raw_path"
# capture fullscreen and save
bindsym $mod+Print          exec grim ~/screenshots/$(date +%Y-%m-%d_%H-%m-%s).png
# select region, then copy to clipboard(no edit)
bindsym $mod+Shift+Print    exec grim -g "$(slurp)" - |  wl-copy

# fuzzel
bindsym $mod+d          exec fuzzel
bindsym $mod+Shift+Tab  exec swaymsg -t get_tree | jq -r '.. | select(.type? == "con" and .name? != null) | "\(.id): \(.name)"' | fuzzel --dmenu | cut -d: -f1 | xargs -I{} swaymsg "[con_id={}] focus"


# exec
bindsym $mod+Return exec $terminal
bindsym $mod+l exec $HOME/.config/scripts/swaylock.sh

# On launch
bar swaybar_command waybar
# fcitx5 for hindi input etc
exec fcitx5 -d
# exec waybar
exec swaync
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# bindsym $mod+Shift+ exec swaync-client -t -sw
exec swayidle -w \
    timeout 600 'swaylock -f --grace 10 -F' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
exec $terminal --title 'btop_monitor' -e btop

# reload configuration file
bindsym $mod+Shift+c      reload
bindsym $mod+Shift+r      reload

# exit
bindsym $mod+Shift+e exit

# kill
bindsym $mod+q            kill
bindsym $mod+Shift+q      kill

# layout and split
bindsym $mod+Shift+s      fullscreen toggle
bindsym $mod+Shift+space  floating toggle
bindsym $mod+h            split h
bindsym $mod+v            split v

# focus
bindsym $mod+Up           focus up
bindsym $mod+a            focus parent
bindsym $mod+z            focus child
bindsym $mod+space        focus mode_toggle

# scratchpad
bindsym $mod+Shift+minus  move scratchpad
bindsym $mod+minus        scratchpad show


# Volume with wpctl
# Initialize volume at startup
exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.3

# Audio controls (--locked: works locked too)
bindsym --locked XF86AudioLowerVolume exec  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioRaiseVolume exec  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+


# Brightness with brightnessctl (--locked: works locked too)
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 10%+


# resize
bindsym $mod+r mode resize
mode "resize" {
  bindsym $mod+r mode default
  bindsym Escape mode default
  bindsym Return mode default

  bindsym Left    resize shrink width   10 px or 10 ppt
  bindsym Right   resize grow   width   10 px or 10 ppt
  bindsym Up      resize shrink height  10 px or 10 ppt
  bindsym Down    resize grow   height  10 px or 10 ppt
}


assign       [class="firefox"]                      2
assign       [title="btop_monitor"]                 10
for_window   [class="firefox" instance="Places"]    focus, floating enable
for_window   [class="mpv"]                          focus, enable
for_window   [floating]                             resize set width 60 ppt height 60 ppt, move absolute position center
for_window   [instance="main"]                      focus, floating enable
for_window   [title="btop_monitor"]                 fullscreen enable

# Right click to eliminate the exitence of window on clicking the title of thw window
bindsym button3 kill

# -- emacs-like --
bindsym $mod+p focus up
bindsym $mod+n focus down
bindsym $mod+b focus left
bindsym $mod+f focus right
bindsym $mod+Shift+p move up
bindsym $mod+Shift+n move down
bindsym $mod+Shift+b move left
bindsym $mod+Shift+f move right


# -- input --
input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

# just read the xkb_options
input * {
    xkb_layout "us"
    xkb_options "caps:ctrl_shifted_capslock,lv3:ralt_switch"
}

# microphone
# exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 # auto mute on boot
# only unmute microphone when pressing the key
# bindsym Control_R exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
# bindsym --release Control_R exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1

# bg
output * bg /usr/share/backgrounds/default.png fill #1e1e2e
